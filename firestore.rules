/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model for the EduStream application.
 * All data is stored in top-level collections: /users/{userId}, /videos/{videoId}, and /playlists/{playlistId}.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data in /users/{userId}.
 * - Videos are publicly readable, but only instructors or admins can create, update, or delete them.
 * - Playlists are publicly readable, but only admins can create, update, or delete them.
 * - Listing of /users is disallowed.
 * - Listing of /videos is allowed.
 * - Listing of /playlists is allowed.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-ownership for profile data. Users can only read and write their own profile.
     * @path /users/{userId}
     * @allow (create, update, get, delete, list) if the request is made by the user with matching {userId}.
     * @deny (create, update, get, delete) if the request is made by a different user.
     * @principle Enforces document ownership for writes; restricts access to a user's own data tree.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to videos, but restricts creation, updating, and deletion to instructors and admins.
     * @path /videos/{videoId}
     * @allow (get, list) any read request.
     * @allow (create, update, delete) only if the user has the role of 'instructor' or 'admin'.
     * @deny (create, update, delete) if the user is not authenticated or does not have the required role.
     * @principle Allows public reads with owner-only writes; enforces role-based access control.
     */
    match /videos/{videoId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isInstructorOrAdmin() {
        return isSignedIn() && (request.auth.token.role == 'instructor' || request.auth.token.role == 'admin');
      }

      allow get, list: if true;

      allow create: if isInstructorOrAdmin() && request.resource.data.authorId == request.auth.uid;
      allow update: if isInstructorOrAdmin() && resource != null;
      allow delete: if isInstructorOrAdmin() && resource != null;
    }

    /**
     * @description Allows public read access to playlists, but restricts creation, updating, and deletion to admins.
     * @path /playlists/{playlistId}
     * @allow (get, list) any read request.
     * @allow (create, update, delete) only if the user has the role of 'admin'.
     * @deny (create, update, delete) if the user is not authenticated or does not have the required role.
     */
    match /playlists/{playlistId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isAdmin() {
        return isSignedIn() && request.auth.token.role == 'admin';
      }

      allow get, list: if true;

      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }
  }
}