/**
 * @fileOverview Firestore Security Rules for EduStream platform.
 *
 * Core Philosophy:
 * This ruleset employs a hybrid security model. User profiles are strictly
 * controlled by their respective owners. Video and Playlist data is publicly
 * readable but writable only by authenticated users (with creator ownership).
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, accessible only by the
 *   user themselves.
 * - /videos/{videoId}: Stores video metadata, publicly readable but
 *   owner-writable.
 * - /playlists/{playlistId}: Stores playlist metadata, publicly readable but
 *   owner-writable.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Public read access is granted for videos and playlists to facilitate
 *   discovery.
 * - Write access to videos and playlists is restricted to authenticated
 *   users who are the creators of the content.
 * - All writes require user authentication.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-ownership for profile data.
     * @path /users/{userId}
     * @allow (create) - User A can create their profile if request.auth.uid == userId
     * @allow (get, update, delete) - User A can access their profile if request.auth.uid == userId
     * @deny (create) - User A cannot create a profile for User B
     * @deny (get, update, delete) - User A cannot access User B's profile
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Allows public read access to video metadata, but restricts writes to authenticated creators.
     * @path /videos/{videoId}
     * @allow (get, list) - Anyone can read video metadata.
     * @allow (create) - User A can create video if isSignedIn().
     * @allow (update, delete) - User A can modify video if isSignedIn().
     * @deny (create) - Non-authenticated user cannot create video.
     * @deny (update, delete) - User A cannot modify video that they do not own or that does not exist.
     * @principle Public read with owner-only writes.
     */
    match /videos/{videoId} {
      function isOwner() {
        return request.auth.uid == resource.data.authorId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isOwner();
      allow delete: if isSignedIn() && isOwner();
    }

    /**
     * @description Allows public read access to playlist metadata, but restricts writes to authenticated creators.
     * @path /playlists/{playlistId}
     * @allow (get, list) - Anyone can read playlist metadata.
     * @allow (create) - User A can create playlist if isSignedIn().
     * @allow (update, delete) - User A can modify playlist if isSignedIn().
     * @deny (create) - Non-authenticated user cannot create playlist.
     * @deny (update, delete) - User A cannot modify playlist that they do not own or that does not exist.
     * @principle Public read with owner-only writes.
     */
    match /playlists/{playlistId} {
      function isOwner() {
        return request.auth.uid == resource.data.authorId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isOwner();
      allow delete: if isSignedIn() && isOwner();
    }
  }
}