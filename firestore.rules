/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model for the EduStream platform.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information. Access is restricted to the owning user and admins.
 * - /videos/{videoId}: Stores video metadata. Publicly readable, but write access is limited to admins and instructors.
 * - /playlists/{playlistId}: Stores playlist metadata. Publicly readable, but write access is limited to admins and instructors.
 *
 * Key Security Decisions:
 * - Public read access to /videos and /playlists.
 * - Restricted write access based on user roles.
 * - No user listing is allowed.
 *
 * Denormalization for Authorization:
 * - Video documents denormalize 'authorId' to easily check ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the resource.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an existing owner of the resource.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user has the 'admin' role.
     */
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    /**
     * @description Checks if the user has the 'instructor' role.
     */
    function isInstructor() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'instructor';
    }

    /**
     * @description Helper to check if the user is an admin or instructor
     */
    function isAdminOrInstructor() {
      return isAdmin() || isInstructor();
    }

    /**
     * @description Enforces document ownership for user profiles.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' creates their profile at /users/user123.
     * @deny (create) User with UID 'user123' attempts to create a profile at /users/user456.
     * @deny (update) Non-admin user tries to update another user's profile.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin(); // Allow admins to list users for user management
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
      
      /**
       * @description User's favorites subcollection
       * @path /users/{userId}/favorites/{videoId}
       * @principle User can manage their own favorites
       */
      match /favorites/{videoId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    /**
     * @description User's progress tracking
     * @path /user-progress/{userId}
     * @principle User can track their own video watch progress
     */
    match /user-progress/{userId} {
      allow read: if isOwner(userId);
      
      match /videos/{videoId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    /**
     * @description User analytics (views, watch time)
     * @path /user-analytics/{userId}
     * @principle User can track their own analytics, admins can read all
     */
    match /user-analytics/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      match /views/{videoId} {
        allow read, write: if isOwner(userId);
      }
      
      match /watch-time/{videoId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    /**
     * @description User notifications
     * @path /notifications/{notificationId}
     * @principle User can read/manage their own notifications, admins can create for all
     */
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isAdminOrInstructor();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    /**
     * @description Quizzes
     * @path /quizzes/{quizId}
     * @principle Public read, admin/instructor write
     */
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isAdminOrInstructor();
    }
    
    /**
     * @description User quiz attempts
     * @path /user-quiz-attempts/{userId}/attempts/{attemptId}
     * @principle User can read/write own attempts
     */
    match /user-quiz-attempts/{userId} {
      allow read: if isOwner(userId); // Allow reading user-quiz-attempts document
      
      match /attempts/{attemptId} {
        allow read, write: if isOwner(userId); // Allow querying and managing attempts
      }
    }
    
    /**
     * @description Certificates
     * @path /certificates/{certificateId}
     * @principle Public read for verification, user can read own, admin can create
     */
    match /certificates/{certificateId} {
      allow read: if true; // Public for verification
      allow create: if isAdminOrInstructor();
      allow update, delete: if isAdmin();
    }
    
    /**
     * @description User notes
     * @path /user-notes/{userId}/notes/{noteId}
     * @principle User can manage their own notes
     */
    match /user-notes/{userId} {
      allow read: if isOwner(userId); // Allow reading user-notes document
      
      match /notes/{noteId} {
        allow read, write: if isOwner(userId); // Allow querying and managing notes
      }
    }
    
    /**
     * @description Comments
     * @path /comments/{commentId}
     * @principle Public read, authenticated users can create, owners can update/delete
     */
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdminOrInstructor());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdminOrInstructor());
    }
    
    /**
     * @description Comment votes
     * @path /comment-votes/{userId}/votes/{commentId}
     * @principle User can manage their own votes
     */
    match /comment-votes/{userId} {
      allow read: if isOwner(userId); // Allow reading comment-votes document
      
      match /votes/{commentId} {
        allow read, write: if isOwner(userId); // Allow querying and managing votes
      }
    }
    
    /**
     * @description User stats for gamification
     * @path /user-stats/{userId}
     * @principle Public read for leaderboard, user can update own
     */
    match /user-stats/{userId} {
      allow read: if true; // Public for leaderboard
      allow write: if isOwner(userId) || isAdmin();
    }

    /**
     * @description Manages access to video metadata.
     * @path /videos/{videoId}
     * @allow (get, list) Any user can read video metadata.
     * @allow (create) Admin user creates a new video entry.
     * @deny (create) Non-admin user attempts to create a video entry.
     * @deny (update, delete) Non-admin user attempts to modify or delete a video entry.
     * @principle Public read access with owner-only writes, restricts write access to admins and instructors.
     */
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdminOrInstructor();
    }

    /**
     * @description Manages access to playlist metadata.
     * @path /playlists/{playlistId}
     * @allow (get, list) Any user can read playlist metadata.
     * @allow (create) Admin user creates a new playlist entry.
     * @deny (create) Non-admin user attempts to create a playlist entry.
     * @deny (update, delete) Non-admin user attempts to modify or delete a playlist entry.
     * @principle Public read access with owner-only writes, restricts write access to admins and instructors.
     */
    match /playlists/{playlistId} {
      allow read: if true;
      allow write: if isAdminOrInstructor();
    }
  }
}