/**
 * @description This ruleset enforces a strict user-ownership model for user profiles and public read access with owner-only writes for videos and playlists.
 * @dataStructure
 *   - /users/{userId}: Stores user profile data, accessible only to the user themselves.
 *   - /videos/{videoId}: Stores video metadata, publicly readable, but only editable by the video's author.
 *   - /playlists/{playlistId}: Stores playlist metadata, publicly readable, but only editable by the playlist's author.
 * @keySecurityDecisions
 *   - Users can only read and write their own profile data.
 *   - Listing of users is explicitly denied to prevent information harvesting.
 *   - Videos and Playlists are publicly readable but have owner-only write access based on the `authorId` field.
 *   - Data shape validation is relaxed to allow for rapid prototyping, focusing on authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.  Only the user themselves can read or write their profile.
     * @path /users/{userId}
     * @allow (get, create, update, delete) if the user's UID matches the {userId} path parameter.
     * @deny (get, create, update, delete) if the user's UID does not match the {userId} path parameter.
     * @principle Enforces document ownership for all operations on user profiles.
     */
    match /users/{userId} {
      // isOwner() utility function
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      // isSignedIn() utility function
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to video documents.  Anyone can read videos, but only the author can create, update, or delete.
     * @path /videos/{videoId}
     * @allow (get, list) to anyone.
     * @allow (create) if the request includes a valid `authorId` field matching the user's UID.
     * @allow (update, delete) if the user is the author of the video.
     * @deny (create, update, delete) if the user is not the author of the video.
     * @principle Public read access with owner-only write access based on the `authorId` field.
     */
    match /videos/{videoId} {
      // isOwner() utility function
      function isOwner() {
        return request.auth != null && resource.data.authorId == request.auth.uid;
      }

      // isSignedIn() utility function
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && isOwner();
      allow delete: if isSignedIn() && isOwner();
    }

    /**
     * @description Controls access to playlist documents.  Anyone can read playlists, but only the author can create, update, or delete.
     * @path /playlists/{playlistId}
     * @allow (get, list) to anyone.
     * @allow (create) if the request includes a valid `authorId` field matching the user's UID.
     * @allow (update, delete) if the user is the author of the playlist.
     * @deny (create, update, delete) if the user is not the author of the playlist.
     * @principle Public read access with owner-only write access based on the `authorId` field.
     */
    match /playlists/{playlistId} {
      // isOwner() utility function
      function isOwner() {
        return request.auth != null && resource.data.authorId == request.auth.uid;
      }

      // isSignedIn() utility function
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && isOwner();
      allow delete: if isSignedIn() && isOwner();
    }
  }
}