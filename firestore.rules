/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a mixed security model, with user-owned profiles and public read access to videos and playlists.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, accessible only to the owner.
 * - /videos/{videoId}: Stores video metadata, publicly readable, but creation and modification is restricted to the video's author.
 * - /playlists/{playlistId}: Stores playlist metadata, publicly readable, but creation and modification is restricted to the playlist's author.
 *
 * Key Security Decisions:
 * - User profiles are strictly private, accessible only to the owning user.
 * - Video and Playlist data is publicly readable to enable discovery, but write access is restricted using the `authorId` field.
 *
 * Denormalization for Authorization:
 * - The `Video` and `Playlist` entities are expected to contain an `authorId` field to enable owner-only write access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile data, ensuring only the owner can read or write.
     * @path /users/{userId}
     * @allow (get, create, update, delete, list): Authenticated user with matching userId.
     * @deny (get, create, update, delete, list): Any other user or unauthenticated request.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages video metadata, allowing public read access but restricting writes to the video's author.
     * @path /videos/{videoId}
     * @allow (get, list): Any user (public read).
     * @allow (create): Authenticated user creating the video, only if `request.resource.data.authorId` matches the user's UID.
     * @allow (update, delete): Authenticated user who is the author of the video (`resource.data.authorId` matches the user's UID).
     * @deny (create, update, delete): Any other user or unauthenticated request attempting to modify the video.
     * @principle Allows public read access for discovery while enforcing document ownership for writes.
     */
    match /videos/{videoId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(authorId) {
        return isSignedIn() && request.auth.uid == authorId;
      }
      function isExistingOwner(authorId) {
        return isOwner(authorId) && resource != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.authorId);
      allow delete: if isExistingOwner(resource.data.authorId);
    }

    /**
     * @description Manages playlist metadata, allowing public read access but restricting writes to the playlist's author.
     * @path /playlists/{playlistId}
     * @allow (get, list): Any user (public read).
     * @allow (create): Authenticated user creating the playlist, only if `request.resource.data.authorId` matches the user's UID.
     * @allow (update, delete): Authenticated user who is the author of the playlist (`resource.data.authorId` matches the user's UID).
     * @deny (create, update, delete): Any other user or unauthenticated request attempting to modify the playlist.
     */
    match /playlists/{playlistId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(authorId) {
        return isSignedIn() && request.auth.uid == authorId;
      }
      function isExistingOwner(authorId) {
          return isOwner(authorId) && resource != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.authorId);
      allow delete: if isExistingOwner(resource.data.authorId);
    }
  }
}