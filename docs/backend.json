{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User Profile",
      "type": "object",
      "description": "Represents a user's profile in the application.",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The unique ID of the user from Firebase Authentication."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's profile picture."
        }
      },
      "required": ["uid", "email"]
    },
    "Video": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Video",
      "type": "object",
      "description": "Represents a video in the EduStream platform.",
      "properties": {
        "title": {
          "type": "string",
          "description": "Title of the video."
        },
        "description": {
          "type": "string",
          "description": "Description of the video content."
        },
        "videoUrl": {
          "type": "string",
          "description": "URL of the video (MP4 URL)."
        },
        "youtubeId": {
          "type": "string",
          "description": "ID of the YouTube video."
        },
        "thumbnailUrl": {
          "type": "string",
          "description": "URL of the video thumbnail."
        },
        "uploadDate": {
          "type": "object",
          "description": "Timestamp when the video was uploaded."
        },
        "duration": {
          "type": "number",
          "description": "Duration of the video in seconds."
        },
        "channel": {
          "type": "string",
          "description": "Name of the channel or user who uploaded the video."
        },
        "channelAvatarUrl": {
          "type": "string",
          "description": "URL of the channel's avatar."
        },
        "playlistIds": {
          "type": "array",
          "description": "References to Playlists. (Relationship: Playlist N:N Video)",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "title",
        "description",
        "thumbnailUrl",
        "uploadDate",
        "duration",
        "channel",
        "channelAvatarUrl"
      ]
    },
    "Playlist": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Playlist",
      "type": "object",
      "description": "Represents a playlist of videos organized by course.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Playlist entity."
        },
        "name": {
          "type": "string",
          "description": "Name of the playlist (e.g., 'Algebra I')."
        },
        "description": {
          "type": "string",
          "description": "Description of the playlist."
        },
        "creationDate": {
          "type": "string",
          "description": "Date and time when the playlist was created.",
          "format": "date-time"
        },
        "videoIds": {
          "type": "array",
          "description": "References to Videos. (Relationship: Video N:N Playlist)",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "creationDate"
      ]
    }
  },
  "auth": {
    "providers": [
      "google.com"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "Stores public profile information for each user.",
          "params": [
            {
              "name": "userId",
              "description": "The unique ID of the user, same as their Firebase Auth UID."
            }
          ]
        }
      },
      {
        "path": "/videos/{videoId}",
        "definition": {
          "entityName": "Video",
          "schema": {
            "$ref": "#/backend/entities/Video"
          },
          "description": "Stores video content metadata. Includes 'playlistIds' array for N:N relationship with Playlists.",
          "params": [
            {
              "name": "videoId",
              "description": "Unique identifier for the video document."
            }
          ]
        }
      },
      {
        "path": "/playlists/{playlistId}",
        "definition": {
          "entityName": "Playlist",
          "schema": {
            "$ref": "#/backend/entities/Playlist"
          },
          "description": "Stores playlist metadata. Includes 'videoIds' array for N:N relationship with Videos.",
          "params": [
            {
              "name": "playlistId",
              "description": "Unique identifier for the playlist document."
            }
          ]
        }
      }
    ]
  }
}
